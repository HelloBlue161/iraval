rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isExchangeParticipant() {
      return request.auth != null && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );
    }

    // Public username registry: { uid, email }, keyed by lowercase username.
    // Needed for signup/login while signed out. Contains no names, birth
    // dates, or locations.
    match /usernames/{username} {
      allow read: if true;
      // Owners maintain their own entry (lets existing users self-heal
      // the registry on next login, and lets QA accounts clean up)
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    // NOTE: chat rules check resource.data.participants (not the document id).
    // Firestore can only allow a query when the rule follows from the
    // query's own filters ("rules are not filters"): the app queries with
    // where('participants', 'array-contains', <own uid>), which is exactly
    // what the rule below requires. Checking the chatId string instead
    // would make every chat query fail with permission-denied.
    match /chats/{chatId} {
      // Only participants can read the conversation
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      // Participants can create/update/delete the conversation doc
      allow create, update, delete: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        // Each message denormalizes the chat's participants array.
        // The parent-doc fallback covers messages written before that
        // field existed.
        allow read: if request.auth != null && (
          request.auth.uid in resource.data.get('participants', []) ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
        );
        // Senders can only post as themselves
        allow create: if request.auth != null
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
        // Delete falls back to the parent chat doc so messages written
        // before the participants field existed can still be removed
        allow delete: if request.auth != null && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []);
      }
    }

    match /users/{userId} {
      // Profiles are discoverable by signed-in users (search, friends,
      // chats) but NOT the open internet. They contain PII (email,
      // birthDate), so unauthenticated reads are denied. Username
      // availability checks use the public /usernames registry instead.
      allow read: if request.auth != null;
      // Only the owner can write their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/books/{bookId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      // Sender must be the signed-in user (no spoofing)
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.receiverId);
      // Only the receiver can accept/decline
      allow update: if request.auth != null
        && request.auth.uid == resource.data.receiverId;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.receiverId);
    }

    match /exchanges/{exchangeId} {
      // Sender must be the signed-in user (no spoofing)
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      // Any signed-in user can read: the search screen filters out books
      // with pending/accepted exchanges via a collection-wide query,
      // which security rules cannot scope per-document.
      allow read: if request.auth != null;
      // Only the two parties can change or remove an exchange
      allow update, delete: if isExchangeParticipant();
    }

    // The custom 6-digit recovery-code flow was removed in favor of
    // Firebase Auth's built-in password-reset email. Deny everything.
    match /recoveryCodes/{codeId} {
      allow read, write: if false;
    }
    match /recoveryAttempts/{attemptId} {
      allow read, write: if false;
    }
  }
}
