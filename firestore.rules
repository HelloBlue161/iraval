rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Anyone can read users (needed for username checks & book search)
      allow read: if true;
      // Only the owner can write their profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/books/{bookId} {
      allow read: if request.auth != null;  // Any logged-in user can search books
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null
        && (request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.receiverId);
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /exchanges/{exchangeId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null
        && (request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.receiverId);
    }

    match /recoveryCodes/{codeId} {
      allow read, write: if request.auth != null;
    }
  }
}
